zopen_append_to_env() {
  # The ROCKSDB_PORT_*_DIR variables were resolved and exported by zopen_init
  # above, so they are available here with their exact version-stamped paths.
  # Using an unquoted END delimiter so the shell expands them when writing .env.
  #
  # Guard pattern: only append if ZOPEN_ROCKSDB_ENV_SET is not already "1".
  # This makes setup.sh safe to source multiple times without duplicating flags.
  cat <<END
if [ "\${ZOPEN_ROCKSDB_ENV_SET}" != "1" ]; then
  export ZOPEN_ROCKSDB_ENV_SET=1
  export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\${PWD}/include"
  export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS} -fzos-le-char-mode=ascii -m64 -mzos-target=zosv2r5 -march=z13 -D__thread= -isystem ${ROCKSDB_PORT_ZOSLIB_DIR}/include -include ${ROCKSDB_PORT_ZOSLIB_DIR}/include/zos-v2r5-symbolfixes.h -I${ROCKSDB_PORT_LIBICONV_DIR}/include -I${ROCKSDB_PORT_NCURSES_DIR}/include -I${ROCKSDB_PORT_NCURSES_DIR}/include/ncurses -I\${PWD}/include"
  export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\${PWD}/lib -L${ROCKSDB_PORT_ZOSLIB_DIR}/lib -L${ROCKSDB_PORT_LIBICONV_DIR}/lib -L${ROCKSDB_PORT_NCURSES_DIR}/lib -Wl,-bSTORENX=YES"
  export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} \${PWD}/lib/librocksdb.a ${ROCKSDB_PORT_GFLAGS_DIR}/lib/libgflags_nothreads.a ${ROCKSDB_PORT_ZOSLIB_DIR}/lib/libzoslib.a \${PWD}/lib/zos_stub_syms.o \${PWD}/lib/zoslib_env_hook.o"
fi
END
}

